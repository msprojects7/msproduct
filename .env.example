# Neon PostgreSQL Database Connection URL (Target Neon branch connection string)
DATABASE_URL=postgresql://username:password@ep-your-endpoint-pooler.region.aws.neon.tech/database?sslmode=verify-full

# Neon Auth Configuration
NEON_AUTH_BASE_URL=https://<endpoint>.neonauth.<region>.aws.neon.tech/<database>/auth
NEON_AUTH_COOKIE_SECRET=your-secure-32-char-min-cookie-secret
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Public SEO & Domain Configuration
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Google Search Console Verification (Optional: TXT token or meta tag token)
# NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=your-google-verification-token

# Google Analytics 4 (Optional: Set your GA4 Measurement ID e.g. G-XXXXXXXXXX)
# Disabled automatically if left unset. Respects user cookie consent mode.
# NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Optional Error Monitoring (e.g. Sentry DSN)
# SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0

# Cloudflare Turnstile CAPTCHA Configuration
# Register your widget at https://dash.cloudflare.com/?to=/:account/turnstile
# For local testing, Cloudflare provides dummy test keys:
# Always Pass: Site key: 1x00000000000000000000AA, Secret: 1x0000000000000000000000000000000AA
# Always Fail: Site key: 2x00000000000000000000AB, Secret: 2x0000000000000000000000000000000AB
NEXT_PUBLIC_TURNSTILE_SITE_KEY=your_turnstile_site_key_here
TURNSTILE_SECRET_KEY=your_turnstile_secret_key_here

